{
  "name": "expense-tracker-auth",
  "version": "1.0.0",
  "description": "A simple signup and login app for an expense tracker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:migrate": "sequelize-cli db:migrate --config database/sequelize-cli.js --migrations-path database/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config database/sequelize-cli.js --migrations-path database/migrations"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
